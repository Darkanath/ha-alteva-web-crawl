# ==========================================
# Alteva Environment Configuration (Template)
# Copy this file to .env and fill in secure values
# ==========================================

# ------------------------------------------
# Docker Compose (interpolated into docker-compose.yml)
# ------------------------------------------

# Runtime
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# SQL Server
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=AltevaCrawlDb
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RABBITMQ_PASSWORD

# Crawler
MAX_PAGES_SAFETY_LIMIT=200
# Pages are downloaded one at a time; a random delay in [MIN, MAX] seconds is applied between downloads.
CRAWLER_DELAY_MIN_SECONDS=3
CRAWLER_DELAY_MAX_SECONDS=5

# ------------------------------------------
# Running the API / Worker outside Docker (dotnet run)
# Not loaded automatically - export these into your shell or IDE run profile.
# Must match the SQL Server / RabbitMQ values above.
# ------------------------------------------
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=AltevaCrawlDb;User Id=sa;Password=REPLACE_WITH_STRONG_PASSWORD;TrustServerCertificate=True;
RabbitMQ__Host=localhost
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=REPLACE_WITH_RABBITMQ_PASSWORD
