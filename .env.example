# ==========================================
# Alteva Environment Configuration (Template)
# Copy this file to .env and fill in secure values
# ==========================================

# Database (SQL Server) Configuration
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=AltevaCrawlDb
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=AltevaCrawlDb;User Id=sa;Password=REPLACE_WITH_STRONG_PASSWORD;TrustServerCertificate=True;

# RabbitMQ Message Broker Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RABBITMQ_PASSWORD

# Application Runtime Configuration
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
MAX_CRAWL_DEPTH_DEFAULT=2
MAX_PAGES_SAFETY_LIMIT=200
